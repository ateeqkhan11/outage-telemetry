  "components": [
    {
      "name": "Shell Bar",
      "kind": "nav",
      "refersTo": "shell",
      "description": "Deep navy top bar with serif wordmark and tabs; current tab white with a 3px underline.",
      "html": "<header class=\"ds-shell\"><a class=\"ds-wordmark\" href=\"#\">Nimbus Index</a><nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Dashboard</a><a href=\"#\">History</a><a href=\"#\">Reports</a><a href=\"#\">API access</a></nav><span class=\"ds-pilot\">Pilot</span></header>",
      "css": ".ds-shell{background:#0C1C36;color:#fff;display:flex;align-items:stretch;gap:0 28px;min-height:58px;padding:0 24px;font-family:'Public Sans',Arial,sans-serif}.ds-wordmark{align-self:center;font:700 20px 'Source Serif 4',Georgia,serif;letter-spacing:-0.01em;color:#fff;text-decoration:none}.ds-nav{display:flex;gap:4px;flex:1}.ds-nav a{color:#B9C8DE;text-decoration:none;padding:0 12px;font-weight:500;font-size:14.5px;display:flex;align-items:center;border-top:3px solid transparent;border-bottom:3px solid transparent;transition:color .15s,border-color .15s}.ds-nav a:hover{color:#fff}.ds-nav a[aria-current=page]{color:#fff;font-weight:600;border-bottom-color:#fff}.ds-nav a:focus-visible{outline:2px solid #fff;outline-offset:-2px}.ds-pilot{align-self:center;font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#fff;border:1px solid #2A426A;padding:2px 8px;border-radius:3px}"
    },
    {
      "name": "Title Band",
      "kind": "custom",
      "refersTo": "band",
      "description": "Navy band carrying the page's one statement, a state bar, a state pill and the verified seal.",
      "html": "<section class=\"ds-band\"><div><h1 class=\"ds-h1\">AWS us-east-1 is up</h1><span class=\"ds-pill\">Up</span></div><div class=\"ds-judges\"><span class=\"ds-seal\">Signed · 3 chains valid</span></div></section>",
      "css": ".ds-band{background:#13294B;color:#fff;padding:34px 24px 38px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px 40px;align-items:center;font-family:'Public Sans',Arial,sans-serif}.ds-h1{margin:0 0 14px;font:600 40px/1.08 'Source Serif 4',Georgia,serif;letter-spacing:-0.015em;padding-bottom:14px;position:relative}.ds-h1::after{content:'';position:absolute;left:0;bottom:0;width:72px;height:4px;border-radius:2px;background:#A8D4BD}.ds-pill{display:inline-flex;align-items:center;gap:7px;font-weight:600;font-size:14px;padding:5px 14px 5px 11px;border-radius:99px;background:#E1F1E8;color:#23664A}.ds-pill::before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor}.ds-judges{border-left:1px solid #2A426A;padding-left:24px}.ds-seal{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#1A1200;background:#E0A526;padding:5px 11px 5px 9px;border-radius:99px}"
    },
    {
      "name": "Ruled Panel and Table",
      "kind": "card",
      "refersTo": "panel",
      "description": "White ruled panel with a serif title and a sunk-headed ruled table with tabular numbers.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-head\"><h2>Services, last 24 hours</h2><p>Bars are 10-minute steps.</p></div><table class=\"ds-table\"><thead><tr><th>Service</th><th>State</th><th class=\"n\">Calls OK</th></tr></thead><tbody><tr><td class=\"svc\">S3</td><td><span class=\"ds-p up\">Up</span></td><td class=\"n\">99.998%</td></tr><tr><td class=\"svc\">Lambda</td><td><span class=\"ds-p down\">Down</span></td><td class=\"n\">71.204%</td></tr><tr><td class=\"svc\">EC2 API</td><td><span class=\"ds-p unk\">Undecided</span></td><td class=\"n\">—</td></tr></tbody></table></section>",
      "css": ".ds-panel{background:#fff;border:1px solid #D6DDE6;border-radius:4px;box-shadow:0 1px 0 rgba(14,23,38,.05);font:15px/1.55 'Public Sans',Arial,sans-serif;color:#0E1726}.ds-head{padding:18px 22px 14px;border-bottom:1px solid #D6DDE6}.ds-head h2{margin:0;font:600 22px/1.2 'Source Serif 4',Georgia,serif}.ds-head p{margin:4px 0 0;color:#4A5869;font-size:14px}.ds-table{border-collapse:collapse;width:100%;font-size:14px}.ds-table th,.ds-table td{text-align:left;padding:11px 14px;border-bottom:1px solid #D6DDE6}.ds-table th{font-size:12.5px;font-weight:600;color:#4A5869;background:#F4F6F9;border-bottom-color:#AEB9C7}.ds-table th:first-child,.ds-table td:first-child{padding-left:22px}.ds-table tr:last-child td{border-bottom:0}.ds-table .n{text-align:right;font-variant-numeric:tabular-nums lining-nums;padding-right:22px}.ds-table .svc{font:600 16px 'Source Serif 4',Georgia,serif}.ds-table tbody tr:hover td{background:#F4F6F9}.ds-p{display:inline-flex;align-items:center;gap:7px;font-weight:600;font-size:13px;padding:3px 11px 3px 9px;border-radius:99px}.ds-p::before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor}.ds-p.up{color:#23664A;background:#E1F1E8}.ds-p.down{color:#A42B1F;background:#FBE6E3}.ds-p.unk{color:#5B6B7F;background:#E6EBF1}"
    },
    {
      "name": "Defined-Terms Table",
      "kind": "custom",
      "refersTo": "deftable-term",
      "description": "Summary of terms: serif defined terms beside their meaning; attachment rows marked in amber.",
      "html": "<table class=\"ds-def\"><tr><th><dfn>Official uptime</dfn></th><td><b class=\"fig\">99.712%</b> all five services</td></tr><tr class=\"att\"><th><dfn>Met a 1-hour waiting period</dfn></th><td><b class=\"fig\">4</b> of 8 outages ran 1 h or longer</td></tr><tr class=\"hd\"><th colspan=\"2\">Definitions</th></tr><tr><th><dfn>Undecided</dfn></th><td>Fewer than 2 companies had results. Never counted as up.</td></tr></table>",
      "css": ".ds-def{border-collapse:collapse;width:100%;font:14px/1.55 'Public Sans',Arial,sans-serif;color:#0E1726;background:#fff}.ds-def th,.ds-def td{text-align:left;padding:11px 14px;border-bottom:1px solid #D6DDE6;vertical-align:top}.ds-def th{width:32%;padding-left:22px}.ds-def dfn{font:600 15.5px 'Source Serif 4',Georgia,serif;font-style:normal}.ds-def .fig{font:600 19px 'Source Serif 4',Georgia,serif;font-variant-numeric:tabular-nums lining-nums;margin-right:6px}.ds-def tr.att dfn::before{content:'';display:inline-block;width:2px;height:12px;background:#E0A526;margin-right:8px;vertical-align:-1px}.ds-def tr.att .fig{color:#7D5200}.ds-def tr.hd th{background:#F4F6F9;border-top:2px solid #AEB9C7;font-size:12.5px;font-weight:600;color:#4A5869}"
    },
    {
      "name": "Trigger Ladder",
      "kind": "custom",
      "refersTo": "ladder-bar",
      "description": "Signature: each outage a loss-red bar on a shared scale crossed by amber waiting-period lines, with met / not met marks.",
      "html": "<div class=\"ds-ladder\"><div class=\"sc\"><span></span><div class=\"tk\"><span style=\"left:0\">0</span><span class=\"a\" style=\"left:33.3%\">1 h wait</span><span class=\"a\" style=\"left:66.6%\">2 h wait</span></div><span></span></div><div class=\"row\"><div class=\"w\"><b>16 Oct 2026</b><span>11:20–16:13 UTC</span></div><div class=\"tr\"><span class=\"bar\" style=\"width:81%\"></span><span class=\"att\" style=\"left:33.3%\"></span><span class=\"att\" style=\"left:66.6%\"></span></div><div class=\"d\">4 h 53 min</div><div class=\"m\">DynamoDB, Lambda <span class=\"met y\">1 h met</span><span class=\"met y\">2 h met</span></div></div><div class=\"row\"><div class=\"w\"><b>29 Jun 2026</b><span>09:41–10:01 UTC</span></div><div class=\"tr\"><span class=\"bar\" style=\"width:6%\"></span><span class=\"att\" style=\"left:33.3%\"></span><span class=\"att\" style=\"left:66.6%\"></span></div><div class=\"d\">20 min</div><div class=\"m\">S3 <span class=\"met\">1 h not met</span><span class=\"met\">2 h not met</span></div></div></div>",
      "css": ".ds-ladder{background:#fff;font:14px/1.5 'Public Sans',Arial,sans-serif;color:#0E1726}.ds-ladder .sc,.ds-ladder .row{display:grid;grid-template-columns:150px minmax(0,1fr) 92px;gap:16px;align-items:center;padding:0 22px}.ds-ladder .sc{height:34px;background:#F4F6F9;border-bottom:1px solid #AEB9C7;font-size:12px;color:#4A5869}.ds-ladder .tk{position:relative;height:100%}.ds-ladder .tk span{position:absolute;bottom:7px;transform:translateX(-50%);white-space:nowrap}.ds-ladder .tk span:first-child{transform:none}.ds-ladder .tk .a{color:#7D5200;font-weight:700}.ds-ladder .row{padding-top:13px;padding-bottom:13px;border-bottom:1px solid #D6DDE6}.ds-ladder .w b,.ds-ladder .w span{display:block}.ds-ladder .w span{font-size:12.5px;color:#4A5869}.ds-ladder .tr{position:relative;height:26px}.ds-ladder .tr::before{content:'';position:absolute;inset:11px 0;background:#F4F6F9;border-radius:2px}.ds-ladder .bar{position:absolute;left:0;top:4px;bottom:4px;min-width:3px;background:#C0392B;border-radius:2px;transform-origin:left;animation:ds-grow 1.1s cubic-bezier(.16,1,.3,1) both}.ds-ladder .att{position:absolute;top:-13px;bottom:-13px;width:2px;margin-left:-1px;background:#E0A526}.ds-ladder .d{text-align:right;font-weight:700;font-variant-numeric:tabular-nums}.ds-ladder .m{grid-column:2/4;display:flex;flex-wrap:wrap;gap:6px 10px;font-size:13px;color:#4A5869;margin-top:-4px}.ds-ladder .met{font-size:12px;font-weight:700;padding:1px 8px;border-radius:3px;border:1px solid #E0A526;color:#7D5200}.ds-ladder .met.y{background:#E0A526;color:#1A1200}@keyframes ds-grow{from{transform:scaleX(.02)}to{transform:scaleX(1)}}@media (prefers-reduced-motion:reduce){.ds-ladder .bar{animation:none}}"
    },
    {
      "name": "Day Squares",
      "kind": "custom",
      "refersTo": "day-square-up",
      "description": "One linked cell per day on a shared grid; three inks plus hatched undecided and empty no-data.",
      "html": "<div class=\"ds-strip\" style=\"--n:14\"><a class=\"u\" href=\"#\"></a><a class=\"u\" href=\"#\"></a><a class=\"mi\" href=\"#\"></a><a class=\"u\" href=\"#\"></a><a class=\"ma\" href=\"#\"></a><a class=\"u\" href=\"#\"></a><a class=\"k\" href=\"#\"></a><a class=\"u\" href=\"#\"></a><a class=\"u\" href=\"#\"></a><a class=\"u\" href=\"#\"></a><a class=\"mi\" href=\"#\"></a><a class=\"u\" href=\"#\"></a><a class=\"no\" href=\"#\"></a><a class=\"u\" href=\"#\"></a></div>",
      "css": ".ds-strip{display:grid;grid-template-columns:repeat(var(--n),minmax(3px,1fr));gap:1px;background:#fff;padding:12px}.ds-strip a{height:30px;border-radius:1px;display:block}.ds-strip a:hover,.ds-strip a:focus-visible{outline:2px solid #0E1726;outline-offset:0;position:relative;z-index:1}.ds-strip .u{background:#A8D4BD}.ds-strip .mi{background:#E9A39A}.ds-strip .ma{background:#C0392B}.ds-strip .k{background:repeating-linear-gradient(135deg,#D3DAE3 0 2px,transparent 2px 4px);background-color:#E6EBF1}.ds-strip .no{background:#E3E8EE}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Navy fill, white 600 text, 4px corners; hover deep navy.",
      "html": "<button class=\"ds-btn\">Run report</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;font:600 14.5px 'Public Sans',Arial,sans-serif;padding:10px 18px;border-radius:4px;border:1px solid #13294B;background:#13294B;color:#fff;cursor:pointer;transition:background .15s,border-color .15s}.ds-btn:hover{background:#0C1C36;border-color:#0C1C36}.ds-btn:focus-visible{outline:2px solid #13294B;outline-offset:2px}.ds-btn:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Paper fill, navy text, strong-rule border; hover navy border on sunk.",
      "html": "<button class=\"ds-btn2\">Download CSV (daily rows)</button>",
      "css": ".ds-btn2{font:600 14.5px 'Public Sans',Arial,sans-serif;padding:10px 18px;border-radius:4px;border:1px solid #AEB9C7;background:#fff;color:#13294B;cursor:pointer;transition:background .15s,border-color .15s}.ds-btn2:hover{border-color:#13294B;background:#F4F6F9}.ds-btn2:focus-visible{outline:2px solid #13294B;outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Paper fill, loss-ink text; hover loss border on loss wash.",
      "html": "<button class=\"ds-btn3\">Revoke</button>",
      "css": ".ds-btn3{font:600 14.5px 'Public Sans',Arial,sans-serif;padding:10px 18px;border-radius:4px;border:1px solid #AEB9C7;background:#fff;color:#A42B1F;cursor:pointer;transition:background .15s,border-color .15s}.ds-btn3:hover{border-color:#C0392B;background:#FBE6E3}.ds-btn3:focus-visible{outline:2px solid #13294B;outline-offset:2px}"
    },
