{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ReadProbeObject", "Effect": "Allow", "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE-probe-bucket-name/probe.txt" },
    { "Sid": "ReadProbeItem", "Effect": "Allow", "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-1:REPLACE_ACCOUNT_ID:table/outage-probe" },
    { "Sid": "InvokeHello", "Effect": "Allow", "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:REPLACE_ACCOUNT_ID:function:outage-probe-hello" },
    { "Sid": "DescribeInstancesCannotBeScopedToAResource", "Effect": "Allow", "Action": "ec2:DescribeInstances",
      "Resource": "*", "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } } }
  ]
}
